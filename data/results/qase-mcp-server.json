        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "enum": [
              "case",
              "suite",
              "run",
              "result",
              "plan",
              "defect",
              "milestone",
              "environment",
              "shared_step",
              "shared_parameter",
              "configuration",
              "attachment",
              "author",
              "user",
              "custom_field"
            ],
            "description": "Entity type to fetch"
          },
          "code": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10,
            "pattern": "^[A-Z0-9_]+$",
            "description": "Project code (required for most entities)"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Entity ID (positive integer)"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Hash identifier"
              }
            ],
            "description": "Entity ID (number) or hash (string)"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional field projection — only return these top-level fields. Pass [\"*\"] for all fields."
          }
        },
        "required": [
          "entity",
          "id"
        ],
        "additionalProperties": false
      }
    },
