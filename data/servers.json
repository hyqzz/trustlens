{
  "$comment": "待评测的能力单元清单。command/args 为可复现的启动方式；source 为来源注册表。第一批为官方参考实现，第二批为高下载量热门服务器（均无需凭证即可运行）。",
  "servers": [
    {
      "name": "mock-echo",
      "type": "mcp-server",
      "source": "builtin-fixture",
      "command": "{python}",
      "args": ["tests/fixtures/mock_mcp_server.py"],
      "note": "内置样例服务器：含正常工具与投毒工具，用于端到端自检与 CI 冒烟"
    },
    {
      "name": "everything",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"],
      "note": "MCP 官方参考/测试服务器，覆盖全部协议特性"
    },
    {
      "name": "filesystem",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "note": "官方文件系统服务器（评测范围限定当前目录）"
    },
    {
      "name": "memory",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "note": "官方知识图谱记忆服务器"
    },
    {
      "name": "time",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=UTC"],
      "note": "官方时间/时区转换服务器（Python）"
    },
    {
      "name": "fetch",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "note": "官方网页抓取服务器（Python）"
    },
    {
      "name": "sequential-thinking",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "note": "官方序列化思考服务器，高下载量"
    },
    {
      "name": "context7",
      "type": "mcp-server",
      "source": "upstash",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "note": "Upstash 出品的文档检索服务器，生态内热门"
    },
    {
      "name": "playwright",
      "type": "mcp-server",
      "source": "microsoft",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "note": "微软出品的浏览器自动化服务器，生态内高热度"
    },
    {
      "name": "desktop-commander",
      "type": "mcp-server",
      "source": "community-popular",
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander@latest"],
      "note": "社区高下载量的桌面操作服务器"
    },
    {
      "name": "git",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."],
      "note": "官方 Git 仓库操作服务器（Python），评测范围限定当前仓库"
    },
    {
      "name": "sqlite",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "probe.sqlite"],
      "note": "官方 SQLite 服务器（Python），评测使用临时库文件"
    }
  ]
}
