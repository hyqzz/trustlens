{
  "$comment": "真实 MCP 服务器清单（来源：npm/PyPI 注册表发现 + 官方实现），enabled:false 表示暂停评测。",
  "servers": [
    {
      "name": "mock-echo",
      "type": "mcp-server",
      "source": "builtin-fixture",
      "command": "{python}",
      "args": [
        "tests/fixtures/mock_mcp_server.py"
      ],
      "note": "内置样例服务器：含正常工具与投毒工具，用于端到端自检与 CI 冒烟"
    },
    {
      "name": "time",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": [
        "mcp-server-time",
        "--local-timezone=UTC"
      ],
      "note": "官方时间/时区转换服务器（Python）"
    },
    {
      "name": "fetch",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "note": "官方网页抓取服务器（Python）"
    },
    {
      "name": "playwright",
      "type": "mcp-server",
      "source": "microsoft",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "note": "微软出品的浏览器自动化服务器，生态内高热度"
    },
    {
      "name": "desktop-commander",
      "type": "mcp-server",
      "source": "community-popular",
      "command": "npx",
      "args": [
        "-y",
        "@wonderwhy-er/desktop-commander@latest"
      ],
      "note": "社区高下载量的桌面操作服务器"
    },
    {
      "name": "git",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "note": "官方 Git 仓库操作服务器（Python），评测范围限定当前仓库"
    },
    {
      "name": "sqlite",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "probe.sqlite"
      ],
      "note": "官方 SQLite 服务器（Python），评测使用临时库文件"
    },
    {
      "name": "commands",
      "type": "mcp-server",
      "source": "community-popular",
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-commands"
      ],
      "note": "社区 shell 命令执行服务器"
    },
    {
      "name": "puppeteer",
      "type": "mcp-server",
      "source": "official-reference",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": false,
      "note": "暂缓评测：探针用哑参数调用浏览器工具会真实启动 Chromium 并挂起——哑探针对浏览器自动化类工具不公平，待评测方法论升级（按工具类型生成合理探针）后恢复"
    },
    {
      "name": "duckduckgo-search",
      "type": "mcp-server",
      "source": "community-popular",
